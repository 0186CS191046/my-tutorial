
{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "strict": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "types": ["node"],
        "rootDir": "src",
        "outDir": "dist",
        "jsx":"react-jsx",
        "allowSyntheticDefaultImports":true,
        "esModuleInterop": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules","dist"]
}