db.carData.aggregate([
    {$project : {model : 1,fuel_type : 1,maker  : 1,_id: 0, 
    fuelCategory : {
        $cond : {
            if : {
                $eq : [
                            "$fuel_type",
                            "Petrol"
                        ]
                    },
                then : "Petrol Car",
            else : "Non Petrol Car"
                },
            }
        }
    }
])

db.carData.aggregate([
    {
        $project : {model: 1,maker: 1,_id: 0,price: 1,
        priceCategory : {
            $switch : {
                branches: [
                        {
                    case : {$lt : [
                                    "$price",
                                    500000
                                ]
                            },
                    then : "Budget"
                        },
                        {
                    case : {$and : [
                                    {$gte : [
                                            "$price",
                                            50000
                                        ]
                                    },
                                    {$lt : [
                                            "$price",
                                            1000000
                                        ]
                                    }
                                ]
                            },
                    then : "Mid Range"
                        },
                        {
                    case : {$gte : [
                                    "$price",
                                    1000000
                                ]
                            },
                    then : "Premium"
                        }
                    ],
            default : "Unknown"
                }
            }
        }
    },
])

