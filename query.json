// Schema Validations

db.createCollection("user2",
{
    validator : {
        $jsonSchema : {
            bsonType : "object",
            required : [
                "name",
                "phone"
            ]
        },
        properties : {
            name: {
                bsonType : "string",
                description : "name should must be string"
            },
            phone : {
                bsonType : "string",
                description : "name should must be string"
            }
        }
    },
    validationLevel : "strict",
validationAction : "error"
}
)

