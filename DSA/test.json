{
    "aggregate": "notifications",
    "pipeline": [
        {
            "$match": {
                "user": {
                    "$oid": "?"
                },
                "isDeleted": "?"
            }
        },
        {
            "$group": {
                "_id": {
                    "$numberInt": "?"
                },
                "n": {
                    "$sum": {
                        "$numberInt": "?"
                    }
                }
            }
        }
    ],
    "cursor": {},
    "$db": "v-pop-api"
}