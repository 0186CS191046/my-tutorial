#include<stdio.h>
#include<iostream.h>
#include<string>
#include<stack>

string reverseParentheses(string s) {
        stack<string> st;
        for(int i=0; i< s.size();i++){
            string temp = "";
            if(s[i] == '(') {
                int curr = i++; 
                while(s[curr] != '(' || s[curr] != ')') {
                    temp += s[curr];
                }
                cout << temp << endl;
                st.push(temp);
            }
        }
        while(!st.empty()){
            cout << st.top() << endl;
            st.pop();
        }
        return s;
}

int main(){
    reverseParentheses("(abcd)")
    return 0;
}
